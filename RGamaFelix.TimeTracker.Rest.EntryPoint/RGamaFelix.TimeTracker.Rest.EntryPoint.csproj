        <ProjectReference Include="..\RGamaFelix.TimeTracker.DataContext.Adapter.SqlServer\RGamaFelix.TimeTracker.DataContext.Adapter.SqlServer.csproj"/>
        <ProjectReference Include="..\RGamaFelix.TimeTracker.Rest.Api\RGamaFelix.TimeTracker.Rest.Api.csproj"/>
    </ItemGroup>

</Project>
